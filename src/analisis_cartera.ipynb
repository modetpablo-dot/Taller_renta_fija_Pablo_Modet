    "# Horquilla mediana por categoría de rating\n",
    "print(universo.groupby('Categoria')['Horquilla'].median(), '\\n')\n",
    "\n",
    "# Bonos excluidos por el mandato por tamaño (≤ 500 millones)\n",
    "pequenos = (universo['Nominal_mill'] <= 500).sum()\n",
