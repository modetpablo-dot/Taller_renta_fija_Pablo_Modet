   "source": [
    "# Agrupamos por emisor: nº de bonos y nominal vivo total\n",
    "emisores = universo.groupby('Issuer').agg(\n",
    "    n_bonos=('Description', 'count'),\n",
    "    nominal_total=('Outstanding Amount', 'sum')\n",
    ")\n",
    "\n",
    "# Peso de cada emisor en una cartera equiponderada (todos los bonos con el mismo peso)\n",
    "emisores['% cartera_eq'] = (emisores['n_bonos'] / len(universo) * 100).round(2)\n",
    "\n",
    "print(f'Número de emisores: {len(emisores)}')\n",
    "emisores.sort_values('n_bonos', ascending=False).head(15)"
   ]
  },
