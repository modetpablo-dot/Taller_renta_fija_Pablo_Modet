   "source": [
    "# Cargamos el universo de bonos\n",
    "universo = pd.read_csv(\n",
    "    RUTA_DATOS + 'universo.csv',\n",
    "    sep=';',                    # el fichero usa ; como separador\n",
    "    encoding='utf-8-sig',       # elimina el carácter BOM invisible del inicio del fichero\n",
    "    na_values=['#N/A N/A']      # marcador de \"sin dato\" de Bloomberg -> NaN\n",
    ")\n",
    "\n",
    "# Convertimos las columnas de fecha de texto (dd/mm/aaaa) a fechas reales\n",
    "cols_fecha = ['Maturity', 'Next Call Date', 'First Coupon Date',\n",
    "              'Penultimate Coupon Date', 'Issue date']\n",
    "for col in cols_fecha:\n",
    "    universo[col] = pd.to_datetime(universo[col], format='%d/%m/%Y')\n",
    "\n",
    "# Usamos el ISIN como índice: es el identificador único de cada bono\n",
    "universo = universo.set_index('ISIN')\n",
    "\n",
    "# Primer vistazo: tipos de cada columna y valores no nulos\n",
    "universo.info()\n",
    "universo.head()"
   ]
  },
