    "# Control de calidad de los precios: tras quitar fines de semana y festivos\n",
    "# (no son huecos de datos) y ANTES de rellenar huecos con ffill (que los ocultaría)\n",
    "cc_precios = fa.control_calidad_precios(precios)\n",
    "cc_precios.to_csv(RUTA_RESULTS + 'control_calidad_precios.csv', sep=';')\n",
