   "source": [
    "# Clasificamos cada bono en IG / HY / Sin rating\n",
    "grado_inversion = escala[:10]   # de AAA a BBB-\n",
    "\n",
    "def clasificar_rating(rating):\n",
    "    \"\"\"Devuelve 'IG', 'HY' o 'Sin rating' según el rating del bono.\"\"\"\n",
    "    if pd.isna(rating) or rating == 'NR':\n",
    "        return 'Sin rating'\n",
    "    return 'IG' if rating in grado_inversion else 'HY'\n",
    "\n",
    "universo['Categoria'] = universo['Rating'].apply(clasificar_rating)\n",
    "universo['Categoria'].value_counts()"
   ]
