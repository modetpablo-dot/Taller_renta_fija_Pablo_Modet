    "# Estadísticas anualizadas de la cartera y del benchmark (datos mensuales -> x12)\n",
    "def estadisticas(rent):\n",
    "    \"\"\"Rentabilidad anualizada, volatilidad anualizada, ratio rent/vol y máximo drawdown.\"\"\"\n",
    "    valor = (1 + rent).cumprod()\n",
    "    n_anios = len(rent) / 12\n",
    "    return pd.Series({\n",
    "        'Rent. acumulada (%)': (valor.iloc[-1] - 1) * 100,\n",
    "        'Rent. anualizada (%)': (valor.iloc[-1] ** (1 / n_anios) - 1) * 100,\n",
    "        'Volatilidad anual (%)': rent.std() * np.sqrt(12) * 100,\n",
    "        'Rent / Vol': (valor.iloc[-1] ** (1 / n_anios) - 1) / (rent.std() * np.sqrt(12)),\n",
    "        'Máx. drawdown (%)': ((valor / valor.cummax()) - 1).min() * 100,\n",
    "    })\n",
    "\n",
    "stats = pd.DataFrame({\n",
    "    'Cartera': estadisticas(backtest['Rent cartera']),\n",
    "    'Benchmark': estadisticas(backtest['Rent benchmark']),\n",
    "})\n",
    "print(stats.round(2), '\\n')\n",
    "\n",
    "# Comparación activa: tracking error y ratio de información\n",
    "tracking_error = backtest['Dif'].std() * np.sqrt(12)\n",
    "ratio_info = backtest['Dif'].mean() * 12 / tracking_error\n",
    "print(f'Tracking error anual: {tracking_error * 100:.2f}%')\n",
    "print(f'Ratio de información: {ratio_info:.2f}')\n",
    "print(f\"Meses batiendo al benchmark: {(backtest['Dif'] > 0).sum()} de {len(backtest)}\")"
   ]
  },
