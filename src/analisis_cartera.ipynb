   "source": [
    "# Escala de ratings de mejor a peor, para ordenar las tablas y gráficos\n",
    "escala = ['AAA', 'AA+', 'AA', 'AA-', 'A+', 'A', 'A-',\n",
    "          'BBB+', 'BBB', 'BBB-',                    # hasta aquí: Investment Grade\n",
    "          'BB+', 'BB', 'BB-', 'B+', 'B', 'B-',      # High Yield\n",
    "          'NR']                                      # sin rating\n",
    "\n",
    "# Nº de bonos por rating en el orden de la escala (eliminamos los que no aparecen)\n",
    "ratings = universo['Rating'].value_counts().reindex(escala).dropna()\n",
    "print(ratings)\n",
    "print(f\"Bonos sin dato de rating (NaN): {universo['Rating'].isna().sum()}\")\n",
    "\n",
    "ratings.plot(kind='bar', figsize=(10, 4))\n",
    "plt.title('Distribución por rating')\n",
    "plt.show()"
   ]
  },
