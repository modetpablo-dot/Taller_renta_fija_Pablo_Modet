    "# Días en los que (casi) ningún bono tiene precio: fines de semana y festivos\n",
    "dias_sin_mercado = pct_nan_dia > 0.9\n",
    "print(f'Días sin mercado: {dias_sin_mercado.sum()}')\n",
    "print(f'De ellos, fines de semana: {(dias_sin_mercado & (precios.index.day_of_week >= 5)).sum()}')\n",
    "\n",
    "# ¿Cuáles de esos días NO son fin de semana? (day_of_week: 0 = lunes ... 6 = domingo)\n",
    "festivos = precios.index[dias_sin_mercado & (precios.index.day_of_week < 5)]\n",
    "print('Festivos entre semana:', list(festivos.strftime('%d/%m/%Y')))"
