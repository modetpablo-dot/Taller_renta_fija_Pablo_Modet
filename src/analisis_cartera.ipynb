    "import os\n",
    "\n",
    "# Control de calidad del universo con las columnas ORIGINALES del fichero\n",
    "# (leemos solo la cabecera del CSV, nrows=0, para no depender de las columnas\n",
    "#  que añadimos después en el notebook)\n",
    "cols_fichero = pd.read_csv(RUTA_DATOS + 'universo.csv', sep=';',\n",
    "                           encoding='utf-8-sig', nrows=0).columns\n",
    "cc_universo = fa.control_calidad_universo(universo.reset_index()[cols_fichero])\n",
    "\n",
    "os.makedirs(RUTA_RESULTS, exist_ok=True)\n",
    "cc_universo.to_csv(RUTA_RESULTS + 'control_calidad_universo.csv', sep=';')\n",
    "cc_universo"
   ]
  },
