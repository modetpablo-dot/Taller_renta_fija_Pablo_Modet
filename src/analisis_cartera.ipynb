    "# Bonos con z-spread poco fiable. El z-spread solo es comparable entre bonos si el plazo con el que\n",
    "# valoramos es razonable; marcamos tres situaciones (un bono puede cumplir varias):\n",
    "#  1) Plazo efectivo < 3 meses: con plazos de semanas, un descuento mínimo se convierte en miles de pb.\n",
    "#  2) Call a <= 95 días del vencimiento y plazo efectivo < 1 año: valoramos a la call (enunciado) pero el mercado suele\n",
    "#     cotizar a vencimiento, así que el precio y el plazo no son coherentes.\n",
    "#  3) Spread fuera de rango plausible (< 0 o > 500 pb) en un universo con mediana ~90 pb.\n",
    "dias_call_a_vto = (universo['Maturity'] - universo['Vto_efectivo']).dt.days\n",
    "\n",
    "motivos = pd.DataFrame({\n",
    "    'Plazo<3m': universo['Plazo_efectivo'] < 0.25,\n",
    "    'CallCercaVto': (dias_call_a_vto > 0) & (dias_call_a_vto <= 95) & (universo['Plazo_efectivo'] < 1),\n",
    "    'SpreadFueraRango': (universo['Spread_pb'] < 0) | (universo['Spread_pb'] > 500),\n",
    "})\n",
    "poco_fiable = motivos.any(axis=1)\n",
    "universo['ZSpread_PocoFiable'] = poco_fiable\n",
    "\n",
    "print('Bonos con z-spread poco fiable:', poco_fiable.sum(), f'({poco_fiable.mean() * 100:.1f}%)')\n",
    "print(motivos.sum().to_string(), '\\n')\n",
    "\n",
    "# Efecto en las estadísticas: con y sin los bonos marcados\n",
    "print(pd.DataFrame({\n",
    "    'Todos': universo['Spread_pb'].describe(),\n",
    "    'Solo fiables': universo.loc[~poco_fiable, 'Spread_pb'].describe(),\n",
    "}).round(1))\n",
    "\n",
    "# Los marcados con spread más extremo\n",
    "universo.loc[poco_fiable, ['Description', 'Price', 'Vto_efectivo', 'Plazo_efectivo', 'Spread_pb']]     .reindex(universo.loc[poco_fiable, 'Spread_pb'].abs().sort_values(ascending=False).index).head(10)"
   ]
  },
