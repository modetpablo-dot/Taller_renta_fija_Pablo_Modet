   "source": [
    "# 4) Estimación de la variación del precio ante una caída de 1% de la yield (dy = -0.01)\n",
    "# Comparamos: (a) solo Duración Modificada, (b) Duración + Convexidad y (c) Revaluación exacta a (y - 0.01)\n",
    "dy = -0.01  # caída de 100 pb en la yield\n",
    "\n",
    "var_solo_dur = (-sensibilidad['ModDur'] * dy) * 100\n",
    "var_dur_conv = sensibilidad['VarPrecioDurConv']  # (-ModDur*dy + 0.5*Convexidad*dy^2) * 100\n",
    "aporte_convexidad = var_dur_conv - var_solo_dur  # 0.5 * Convexidad * dy^2 * 100\n",
    "\n",
    "def variacion_exacta_precio(bono, y, dy=-0.01):\n",
    "    fl = fa.flujos_bono(bono, fecha_valor)\n",
    "    t = fl['Plazo'].values\n",
    "    cf = fl['Flujo'].values\n",
    "    p0 = (cf * (1.0 + y) ** (-t)).sum()\n",
    "    p1 = (cf * (1.0 + y + dy) ** (-t)).sum()\n",
    "    return (p1 / p0 - 1.0) * 100\n",
    "\n",
    "var_exacta = universo.apply(lambda b: variacion_exacta_precio(b, sensibilidad.at[b.name, 'Yield'], dy), axis=1)\n",
    "\n",
    "comparativa_dy = pd.DataFrame({\n",
    "    'SoloDur (%)': var_solo_dur,\n",
    "    'Dur+Conv (%)': var_dur_conv,\n",
    "    'Exacta (%)': var_exacta,\n",
    "    'AporteConv (% precio)': aporte_convexidad,\n",
    "    'Error_SoloDur (%)': (var_exacta - var_solo_dur).abs(),\n",
    "    'Error_DurConv (%)': (var_exacta - var_dur_conv).abs(),\n",
    "})\n",
    "print('Comparativa de variación del precio (%) ante caída de 1% en la yield:')\n",
    "display(comparativa_dy.describe().round(4))\n",
    "\n",
    "print('\\nTop 5 bonos con mayor aporte de convexidad (plazos más largos):')\n",
    "top_conv = comparativa_dy.join(universo[['Description', 'Plazo_efectivo']]).join(\n",
    "    sensibilidad[['ModDur', 'Convexidad']]\n",
    ").sort_values('Convexidad', ascending=False).head(5)\n",
    "display(top_conv[['Description', 'Plazo_efectivo', 'ModDur', 'Convexidad',\n",
    "                  'SoloDur (%)', 'Dur+Conv (%)', 'Exacta (%)', 'AporteConv (% precio)']].round(3))\n",
    "\n",
    "# Visualización\n",
    "fig, ax = plt.subplots(1, 2, figsize=(14, 4.5))\n",
    "\n",
    "orden = sensibilidad['ModDur'].sort_values().index\n",
    "ax[0].plot(sensibilidad.loc[orden, 'ModDur'], var_solo_dur.loc[orden],\n",
    "           label='1er orden: solo Duración (-ModDur·Δy)', linestyle='--', color='orange')\n",
    "ax[0].scatter(sensibilidad['ModDur'], var_dur_conv, s=12, alpha=0.7,\n",
    "              color='deepskyblue', label='2º orden: Duración + Convexidad')\n",
    "ax[0].scatter(sensibilidad['ModDur'], var_exacta, s=6, alpha=0.5,\n",
    "              color='lime', label='Revaluación exacta P(y - 1%)')\n",
    "ax[0].set_xlabel('Duración Modificada (años)')\n",
    "ax[0].set_ylabel('Variación del precio sucio (%)')\n",
    "ax[0].set_title('Subida del precio ante caída de 1% (-100 pb) en la yield')\n",
    "ax[0].legend()\n",
    "\n",
    "ax[1].scatter(universo['Plazo_efectivo'], aporte_convexidad, s=10, alpha=0.7, color='violet')\n",
    "ax[1].set_xlabel('Plazo efectivo (años)')\n",
    "ax[1].set_ylabel('Aporte de la convexidad: +½·Conv·(Δy)² (%)')\n",
    "ax[1].set_title('Efecto de la convexidad con el plazo (crecimiento cuadrático ~ t²)')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
