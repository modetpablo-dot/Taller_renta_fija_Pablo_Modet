   "source": [
    "# 1) Cálculo de Yield (TIR anual), Duración de Macaulay, Duración Modificada y Convexidad\n",
    "yields = universo.apply(lambda bono: fa.ytm(bono, fecha_valor, bono['Price']), axis=1)\n",
    "\n",
    "medidas_riesgo = universo.apply(\n",
    "    lambda bono: pd.Series(fa.risk_measures(bono, fecha_valor, yields[bono.name])), axis=1\n",
    ")\n",
    "\n",
    "# Variación estimada del precio (%) ante una caída de 1% (-100 pb -> dy = -0.01) en la yield:\n",
    "# dP / P ≈ (-ModDur · dy + 0.5 · Convexidad · dy²) · 100\n",
    "dy = -0.01\n",
    "var_precio_dur_conv = (\n",
    "    -medidas_riesgo['ModDur'] * dy + 0.5 * medidas_riesgo['Convexidad'] * (dy ** 2)\n",
    ") * 100\n",
    "\n",
    "sensibilidad = pd.DataFrame({\n",
    "    'Yield': yields,                              # tanto por uno (0.04 = 4%)\n",
    "    'Dur': medidas_riesgo['Dur'],                 # años (Macaulay)\n",
    "    'ModDur': medidas_riesgo['ModDur'],           # años (Dur / (1 + Yield))\n",
    "    'Convexidad': medidas_riesgo['Convexidad'],   # años²\n",
    "    'VarPrecioDurConv': var_precio_dur_conv,      # variación estimada del precio en %\n",
    "})\n",
    "sensibilidad.index.name = 'ISIN'\n",
    "\n",
    "# Guardamos en results/sensibilidad.csv\n",
    "sensibilidad.to_csv(RUTA_RESULTS + 'sensibilidad.csv', sep=';')\n",
    "print('Guardado:', os.path.abspath(RUTA_RESULTS + 'sensibilidad.csv'))\n",
    "print('Comprobación NaNs:', sensibilidad.isna().sum().to_dict())\n",
    "\n",
    "# Guardamos también las columnas principales en universo para los análisis siguientes\n",
    "universo['Yield'] = sensibilidad['Yield']\n",
    "universo['Dur'] = sensibilidad['Dur']\n",
    "universo['ModDur'] = sensibilidad['ModDur']\n",
    "universo['Convexidad'] = sensibilidad['Convexidad']\n",
    "universo['VarPrecioDurConv'] = sensibilidad['VarPrecioDurConv']\n",
    "\n",
    "sensibilidad.describe().round(4)"
   ]
  },
