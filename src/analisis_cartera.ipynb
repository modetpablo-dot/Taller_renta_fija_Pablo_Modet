   "source": [
    "# Cargamos los precios históricos: filas = bonos, columnas = fechas\n",
    "precios = pd.read_csv(\n",
    "    RUTA_DATOS + 'precios_historicos_universo.csv',\n",
    "    sep=';',\n",
    "    index_col=0,             # la primera columna (identificador del bono) será el índice\n",
    "    na_values=['#N/D'],      # marcador de \"sin dato\" -> NaN\n",
    "    encoding='utf-8-sig'\n",
    ")\n",
    "\n",
    "# Transponemos: filas = fechas, columnas = bonos\n",
    "precios = precios.T\n",
    "\n",
    "# Convertimos el índice (texto) a fechas\n",
    "precios.index = pd.to_datetime(precios.index, format='%d/%m/%Y')\n",
    "\n",
    "# Los identificadores vienen como 'XS0161488498 Corp': nos quedamos solo con el ISIN\n",
    "precios.columns = precios.columns.str.replace(' Corp', '', regex=False)\n",
    "\n",
    "print(precios.shape)\n",
    "print('¿Mismos bonos que en el universo?', set(precios.columns) == set(universo.index))"
   ]
  },
