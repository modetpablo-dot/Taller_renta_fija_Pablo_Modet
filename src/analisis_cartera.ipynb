    "# Tests de regresión (\"golden fixtures\") sobre 6 bonos con casuísticas distintas del pricer.\n",
    "# Comprobamos propiedades que deben cumplirse siempre en S2 (precio), S3 (z-spread) y S4 (yield/dur/conv).\n",
    "fixtures = {\n",
    "    'XS0161488498': 'anual, sin call',\n",
    "    'XS1821883102': 'semestral',\n",
    "    'FR0014001I50': 'cupón cero',\n",
    "    'XS1206541366': 'perpetuo (a su call)',\n",
    "    'XS1186176571': 'call ya pasada (-> vencimiento)',\n",
    "    'XS1405762805': 'call fuera de calendario (stub)',\n",
    "}\n",
    "for isin, caso in fixtures.items():\n",
    "    b = universo.loc[isin]\n",
    "    fl = fa.flujos_bono(b, fecha_valor)\n",
    "    v = fa.valorar_bono(b, curva, fecha_valor)\n",
    "    vto = fa.fecha_vencimiento_efectiva(b, fecha_valor)\n",
    "    plazo_ef = (vto - fecha_valor).days / 365\n",
    "\n",
    "    assert fl['Fecha'].iloc[-1] == vto, 'el último flujo debe caer en el vencimiento efectivo'\n",
    "    assert (fl['Plazo'] > 0).all(), 'todos los flujos son futuros'\n",
    "    assert fl['Flujo'].iloc[-1] >= 100, 'el último flujo incluye el nominal'\n",
    "    assert 0 <= v['CuponCorrido'] < b['Coupon'] + 1e-9 or b['Coupon'] == 0, 'cupón corrido <= cupón anual'\n",
    "    assert abs(v['PrecioSucio'] - v['PrecioLimpio'] - v['CuponCorrido']) < 1e-12, 'sucio = limpio + corrido'\n",
    "\n",
    "    # S3: el z-spread debe reproducir el precio de mercado (ida y vuelta)\n",
    "    s = fa.z_spread(b, curva, fecha_valor, b['Price'])\n",
    "    assert abs(fa.valorar_bono(b, curva, fecha_valor, spread=s)['PrecioLimpio'] - b['Price']) < 1e-6\n",
    "\n",
    "    # S4: la yield anual debe reproducir el precio sucio de mercado y cumplir 0 < Dur <= Plazo_efectivo\n",
    "    y = fa.ytm(b, fecha_valor, b['Price'])\n",
    "    rm = fa.risk_measures(b, fecha_valor, y)\n",
    "    p_sucio_y = (fl['Flujo'].values * (1.0 + y) ** (-fl['Plazo'].values)).sum()\n",
    "    assert abs(p_sucio_y - (b['Price'] + v['CuponCorrido'])) < 1e-6, 'la yield debe reproducir el precio sucio'\n",
    "    assert 0 < rm['Dur'] <= plazo_ef + 1e-12, 'la duración de Macaulay no puede superar el plazo efectivo'\n",
    "    assert abs(rm['ModDur'] - rm['Dur'] / (1.0 + y)) < 1e-12, 'ModDur = Dur / (1 + y)'\n",
    "    assert rm['Convexidad'] > 0, 'la convexidad debe ser positiva'\n",
    "\n",
    "    print(\n",
    "        f'OK  {isin}  {caso:32s} flujos={len(fl):2d}  limpio={v[\"PrecioLimpio\"]:7.3f}  '\n",
    "        f'mkt={b[\"Price\"]:7.3f}  z={s*1e4:6.1f}pb  y={y*100:5.2f}%  Dur={rm[\"Dur\"]:5.2f}a'\n",
    "    )\n",
    "\n",
    "# Un bono cupón cero no tiene cupón corrido y su duración de Macaulay coincide exactamente con su plazo\n",
    "assert fa.cupon_corrido(universo.loc['FR0014001I50'], fecha_valor) == 0\n",
