    "# 3) Relación entre Duración y Vencimiento, y obtención alternativa por diferencias finitas (revaluación)\n",
    "n_flujos = universo.apply(lambda b: len(fa.flujos_bono(b, fecha_valor)), axis=1)\n",
    "es_cero_o_1flujo = (universo['Coupon'] == 0) | (n_flujos == 1)\n",
    "\n",
    "print('Bonos cupón cero (14) o con 1 solo flujo restante (407):', es_cero_o_1flujo.sum())\n",
    "print('  -> Máxima diferencia |Dur - Plazo_efectivo|:',\n",
    "      (sensibilidad.loc[es_cero_o_1flujo, 'Dur'] - universo.loc[es_cero_o_1flujo, 'Plazo_efectivo']).abs().max())\n",
    "print('Bonos con >1 flujo y cupón > 0:', (~es_cero_o_1flujo).sum())\n",
    "print('  -> ¿Se cumple Dur < Plazo_efectivo en TODOS ellos?:',\n",
    "      (sensibilidad.loc[~es_cero_o_1flujo, 'Dur'] < universo.loc[~es_cero_o_1flujo, 'Plazo_efectivo'] - 1e-12).all(), '\\n')\n",
    "\n",
    "# Obtención alternativa de ModDur y Convexidad mediante diferencias finitas centradas (bump de ±1 pb en la yield)\n",
    "delta_y = 1e-4  # 1 punto básico (0.01%)\n",
    "\n",
    "def sensibilidad_numerica(bono, y, h=1e-4):\n",
    "    fl = fa.flujos_bono(bono, fecha_valor)\n",
    "    t = fl['Plazo'].values\n",
    "    cf = fl['Flujo'].values\n",
    "    p0 = (cf * (1.0 + y) ** (-t)).sum()\n",
    "    p_mas = (cf * (1.0 + y + h) ** (-t)).sum()\n",
    "    p_menos = (cf * (1.0 + y - h) ** (-t)).sum()\n",
    "    mod_dur_num = -(p_mas - p_menos) / (2.0 * p0 * h)\n",
    "    conv_num = (p_mas - 2.0 * p0 + p_menos) / (p0 * (h ** 2))\n",
    "    return pd.Series({'ModDur_num': mod_dur_num, 'Conv_num': conv_num})\n",
    "\n",
    "num_check = universo.apply(lambda b: sensibilidad_numerica(b, sensibilidad.at[b.name, 'Yield'], delta_y), axis=1)\n",
    "print('Error máximo |ModDur analítica - ModDur numérica (±1 pb)|:',\n",
    "      (sensibilidad['ModDur'] - num_check['ModDur_num']).abs().max().round(8))\n",
    "print('Error máximo |Convexidad analítica - Convexidad numérica (±1 pb)|:',\n",
    "      (sensibilidad['Convexidad'] - num_check['Conv_num']).abs().max().round(6))\n",
    "\n",
    "# Gráfico: Duración de Macaulay vs Plazo efectivo coloreado por el tamaño del cupón\n",
    "fig, ax = plt.subplots(1, 2, figsize=(14, 4.5))\n",
    "\n",
    "sc1 = ax[0].scatter(\n",
    "    universo['Plazo_efectivo'], sensibilidad['Dur'],\n",
    "    c=universo['Coupon'], cmap='plasma', s=10, alpha=0.75\n",
    ")\n",
    "plt.colorbar(sc1, ax=ax[0], label='Cupón anual (%)')\n",
    "max_t = universo['Plazo_efectivo'].max()\n",
    "ax[0].plot([0, max_t], [0, max_t], color='white', linestyle='--', linewidth=1, label='Cupón cero (Dur = Plazo)')\n",
    "ax[0].set_xlabel('Plazo hasta vencimiento efectivo (años)')\n",
    "ax[0].set_ylabel('Duración de Macaulay (años)')\n",
    "ax[0].set_title('Duración de Macaulay vs Vencimiento efectivo')\n",
    "ax[0].legend()\n",
    "\n",
    "# Diferencia (Plazo_efectivo - Dur) frente al plazo y cupón\n",
    "sc2 = ax[1].scatter(\n",
