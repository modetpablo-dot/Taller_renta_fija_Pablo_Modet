    "    'PrecioSucioCalculado': valores['PrecioSucio'],\n",
    "    'CuponCorrido': valores['CuponCorrido'],\n",
    "    'PrecioLimpioCalculado': valores['PrecioLimpio'],\n",
    "})\n",
    "\n",
    "# Diferencia mercado - cálculo (en puntos de precio y en % sobre el precio de mercado)\n",
    "valoracion['DiferenciaMecadoCalculo'] = valoracion['PrecioMercado'] - valoracion['PrecioLimpioCalculado']\n",
    "valoracion['DiferenciaPct'] = valoracion['DiferenciaMecadoCalculo'] / valoracion['PrecioMercado'] * 100\n",
    "\n",
    "valoracion.index.name = 'ISIN'\n",
    "valoracion.describe().round(3)"
