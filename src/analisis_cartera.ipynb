   "source": [
    "# Horquilla bid-ask en puntos de precio\n",
    "universo['Horquilla'] = universo['Ask Price'] - universo['Bid Price']\n",
    "\n",
    "# Nominal vivo en millones, más fácil de leer\n",
    "universo['Nominal_mill'] = universo['Outstanding Amount'] / 1e6\n",
    "\n",
    "universo[['Horquilla', 'Nominal_mill']].describe()"
   ]
  },
